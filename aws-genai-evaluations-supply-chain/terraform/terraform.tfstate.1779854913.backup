    {
      "mode": "managed",
      "type": "aws_cloudwatch_log_resource_policy",
      "name": "xray_transaction_search",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "TransactionSearchAccess",
            "policy_document": "{\"Statement\":[{\"Action\":\"logs:PutLogEvents\",\"Condition\":{\"ArnLike\":{\"aws:SourceArn\":\"arn:aws:xray:us-east-1:689069515280:*\"},\"StringEquals\":{\"aws:SourceAccount\":\"689069515280\"}},\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"xray.amazonaws.com\"},\"Resource\":[\"arn:aws:logs:us-east-1:689069515280:log-group:aws/spans:*\",\"arn:aws:logs:us-east-1:689069515280:log-group:/aws/application-signals/data:*\"],\"Sid\":\"TransactionSearchXRayAccess\"}],\"Version\":\"2012-10-17\"}",
